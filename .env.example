# OpenAI API Key (для AI категоризации и чата)
# Получить: https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"

# Port (опционально, по умолчанию 3000)
PORT=3000

# Database path (опционально, по умолчанию ./data/finance.db)
# На Vercel нужно использовать PostgreSQL вместо SQLite
DATABASE_URL="postgresql://user:password@host:port/dbname"

# Node environment
NODE_ENV=development
